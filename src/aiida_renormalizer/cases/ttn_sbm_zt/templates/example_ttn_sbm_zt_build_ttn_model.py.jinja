def build_tree_topology(basis):
    by_dof = {item.dofs[0]: item for item in basis}
    bath_basis = [by_dof[dof] for dof in TOPOLOGY["bath_dofs"]]
    root_basis = [by_dof[dof] for dof in TOPOLOGY["root_dofs"]]
    root = BasisTree.binary_mctdh(
        bath_basis,
        contract_primitive=TOPOLOGY["contract_primitive"],
        contract_label=TOPOLOGY["contract_labels"],
        dummy_label=TOPOLOGY["dummy_label"],
    ).root
    root.add_child(TreeNodeBasis(root_basis))
    return BasisTree(root)


def build_network_operators_and_state():
    basis, ham_terms = build_model_with_op_and_basis()
    basis_tree = build_tree_topology(basis)
    ttno = TTNO(basis_tree, ham_terms)
    # Occupations describe an undisplaced product state, not an interacting ground state.
    ttns = TTNS(basis_tree, condition=INITIAL_STATE)
    ttns.compress_config = CompressConfig(
        CompressCriteria.fixed, max_bonddim=COMPRESSION["max_bonddim"]
    )
    if EXPANSION["enabled"]:
        ttns = expand_bond_dimension_general(
            ttns, ttno, coef=EXPANSION["coefficient"], ex_mps=None
        )
    return ttns, ttno, basis_tree
